# --- Demo mode -------------------------------------------------------------
# When true (or when ANTHROPIC_API_KEY is missing), the app runs entirely on
# canned demo data: no AI, Supabase, or Stripe calls are made. This lets you
# test and demo the full product with zero configuration.
DEMO_MODE=true

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (Anthropic) ----------------------------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Supabase ------------------------------------------------------------------
# Project settings > API. The service role key is server-only, never expose it
# to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe --------------------------------------------------------------------
# Create a one-time 19€ price in the Stripe dashboard and paste its ID below.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Analytics (optional) -----------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Admin dashboard -----------------------------------------------------------
# Protects /admin/analytics with HTTP Basic Auth. Required to view the
# dashboard; the funnel still tracks fine without it, you just can't see it.
ADMIN_USERNAME=
ADMIN_PASSWORD=
